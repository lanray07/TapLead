    "Edit this starter in your own words. TapLead does not send messages or assume the connection has been contacted.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formulieren Sie diesen Gesprächseinstieg in eigenen Worten. TapLead versendet keine Nachrichten und geht nicht davon aus, dass der Kontakt bereits angesprochen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit this starter in your own words. TapLead does not send messages or assume the connection has been contacted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita este mensaje de inicio con tus propias palabras. TapLead no envía mensajes ni asume que se ha contactado a la persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez ce message d'accroche avec vos propres mots. TapLead n'envoie pas de messages et ne considère pas que la connexion a été contactée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica questo messaggio iniziale con parole tue. TapLead non invia messaggi né presume che il contatto sia stato contattato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の言葉で会話のきっかけ（スターター）を編集してください。TapLeadがメッセージを送信したり、相手に連絡済みとみなしたりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 문구로 시작 멘트를 편집하세요. TapLead는 메시지를 발송하거나 해당 연결과 연락이 이루어졌다고 간주하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerk deze openingszin in je eigen woorden. TapLead verstuurt geen berichten en gaat er niet vanuit dat er al contact is opgenomen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite esta mensagem inicial com suas próprias palavras. O TapLead não envia mensagens nem assume que a conexão foi contatada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用您自己的话编辑开场白。TapLead 不会自动发送消息，也不会默认您已联系该对象。"
          }
        }
      }
    },
