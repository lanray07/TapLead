    "Deleting your account does not cancel your App Store subscription. Manage subscriptions in your Apple account.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen Ihres Kontos beendet nicht Ihr App-Store-Abonnement. Verwalten Sie Abonnements in Ihrem Apple-Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
