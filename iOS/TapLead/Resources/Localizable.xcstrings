    "On-device AI needs iOS 26 and an available Apple Intelligence model for your language. You can still write notes and introductions yourself.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI auf dem Gerät erfordert iOS 26 und ein für deine Sprache verfügbares Apple Intelligence-Modell. Du kannst Notizen und Einleitungstexte weiterhin selbst verfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device AI needs iOS 26 and an available Apple Intelligence model for your language. You can still write notes and introductions yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA en el dispositivo requiere iOS 26 y un modelo de Apple Intelligence disponible para tu idioma. Aún puedes redactar notas y presentaciones tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA sur l’appareil nécessite iOS 26 et un modèle Apple Intelligence disponible pour votre langue. Vous pouvez toujours rédiger vous-même vos notes et introductions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA su dispositivo richiede iOS 26 e un modello Apple Intelligence disponibile per la tua lingua. Puoi comunque scrivere personalmente note e introduzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のAIを利用するには、iOS 26と、お使いの言語に対応したApple Intelligenceモデルが必要です。引き続き、ご自身でメモや紹介文を作成することは可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 AI를 사용하려면 iOS 26 및 해당 언어에 맞는 Apple Intelligence 모델이 필요합니다. 메모와 소개 문구는 직접 작성하실 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor AI op het apparaat zijn iOS 26 en een beschikbaar Apple Intelligence-model voor uw taal vereist. U kunt nog steeds zelf notities en introducties schrijven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA no dispositivo requer o iOS 26 e um modelo do Apple Intelligence disponível para o seu idioma. Você ainda pode escrever notas e apresentações pessoalmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端 AI 需要 iOS 26 系统以及适用于您语言的 Apple Intelligence 模型。您仍可自行撰写备注和介绍。"
          }
        }
      }
    },
    "On-device AI needs iOS 26, Apple Intelligence enabled, and a supported device and language. Your notes and manual introduction drafts remain available.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI auf dem Gerät erfordert iOS 26, die Aktivierung von Apple Intelligence sowie ein unterstütztes Gerät und eine unterstützte Sprache. Deine Notizen und manuell erstellten Entwürfe für Einleitungstexte bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device AI needs iOS 26, Apple Intelligence enabled, and a supported device and language. Your notes and manual introduction drafts remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA en el dispositivo requiere iOS 26, tener activada la función Apple Intelligence y contar con un dispositivo y un idioma compatibles. Tus notas y borradores de presentación manuales seguirán estando disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA sur l’appareil nécessite iOS 26, l’activation d’Apple Intelligence ainsi qu’un appareil et une langue pris en charge. Vos notes et vos brouillons d’introduction manuels restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA su dispositivo richiede iOS 26, Apple Intelligence abilitata e un dispositivo e una lingua supportati. Le tue note e le bozze di introduzione manuale rimangono disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のAIを利用するには、iOS 26、Apple Intelligenceの有効化、および対応デバイスと対応言語が必要です。作成済みのメモや手動で入力した紹介文のドラフトは引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 AI를 사용하려면 iOS 26, Apple Intelligence 활성화, 그리고 지원되는 기기 및 언어가 필요합니다. 작성하신 메모와 수동 소개 초안은 계속 이용 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor AI op het apparaat zijn iOS 26, ingeschakelde Apple Intelligence en een ondersteund apparaat en taal vereist. Uw notities en handmatige concepten voor introducties blijven beschikbaar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA no dispositivo requer o iOS 26, o Apple Intelligence ativado e um dispositivo e idioma compatíveis. Suas notas e rascunhos de apresentação manuais permanecem disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端 AI 需要 iOS 26 系统、已启用的 Apple Intelligence 功能，以及受支持的设备和语言。您的备注和手动撰写的介绍草稿仍可使用。"
          }
        }
      }
    },
    "On-device speech recognition is unavailable for this language or device. You can type your note instead.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung auf dem Gerät ist für diese Sprache oder dieses Gerät nicht verfügbar. Du kannst deine Notiz stattdessen eintippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device speech recognition is unavailable for this language or device. You can type your note instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz en el dispositivo no está disponible para este idioma o dispositivo. Puedes escribir la nota en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale sur l’appareil n’est pas disponible pour cette langue ou cet appareil. Vous pouvez saisir votre note au clavier à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale su dispositivo non è disponibile per questa lingua o questo dispositivo. Puoi digitare la nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語またはデバイスでは、デバイス上の音声認識は利用できません。代わりにテキストを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어 또는 기기에서는 기기 내 음성 인식을 사용할 수 없습니다. 대신 메모를 직접 입력할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning op het apparaat is niet beschikbaar voor deze taal of dit apparaat. U kunt uw notitie in plaats daarvan typen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala no dispositivo não está disponível para este idioma ou dispositivo. Você pode digitar sua nota em vez disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语言或设备不支持设备端语音识别。您可以改为输入备注。"
          }
        }
      }
    },
