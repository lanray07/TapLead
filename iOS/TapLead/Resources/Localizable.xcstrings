    "Show one logo or photo in your chosen corner. The selected image is uploaded when you publish; other images remain on this iPhone.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie ein Logo oder Foto in der von Ihnen gewählten Ecke an. Das ausgewählte Bild wird beim Veröffentlichen hochgeladen; andere Bilder verbleiben auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show one logo or photo in your chosen corner. The selected image is uploaded when you publish; other images remain on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un logotipo o una foto en la esquina que elijas. La imagen seleccionada se sube al publicar; las demás imágenes permanecen en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher un logo ou une photo dans le coin de votre choix. L'image sélectionnée est téléchargée lors de la publication ; les autres images restent sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un logo o una foto nell'angolo scelto. L'immagine selezionata viene caricata al momento della pubblicazione; le altre immagini rimangono su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した隅にロゴまたは写真を1つ表示します。選択した画像は公開時にアップロードされ、他の画像はこのiPhone上に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 모서리에 로고나 사진을 표시하세요. 게시 시 선택한 이미지만 업로드되며, 다른 이미지는 이 iPhone에 그대로 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon één logo of foto in de gekozen hoek. De geselecteerde afbeelding wordt geüpload bij publicatie; andere afbeeldingen blijven op deze iPhone staan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
