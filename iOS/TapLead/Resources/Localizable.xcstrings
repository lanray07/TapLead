    "Guest cards and notes stay on this iPhone. Sign in with Apple when you’re ready to publish and sync.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Gastmodus bleiben deine Karten und Notizen auf diesem iPhone. Melde dich mit Apple an, wenn du sie veröffentlichen und synchronisieren möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guest cards and notes stay on this iPhone. Sign in with Apple when you’re ready to publish and sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En modo invitado, tus tarjetas y notas se guardan en este iPhone. Inicia sesión con Apple cuando quieras publicar y sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode invité, vos cartes et notes restent sur cet iPhone. Connectez-vous avec Apple quand vous souhaitez les publier et les synchroniser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità ospite, i tuoi biglietti e le tue note restano su questo iPhone. Accedi con Apple quando vuoi pubblicarli e sincronizzarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストモードのカードとメモは、このiPhoneに保存されます。公開や同期を行う際は、Appleでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 모드의 명함과 메모는 이 iPhone에 저장됩니다. 게시하거나 동기화하려면 Apple로 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de gastmodus blijven je kaarten en notities op deze iPhone. Log in met Apple wanneer je wilt publiceren en synchroniseren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo visitante, seus cartões e notas ficam neste iPhone. Inicie sessão com a Apple quando quiser publicar e sincronizar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访客模式下，您的名片和备注保存在此 iPhone 上。需要发布和同步时，请使用 Apple 账号登录。"
          }
        }
      }
    },
