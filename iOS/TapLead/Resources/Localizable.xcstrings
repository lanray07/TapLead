    "Record contact details only with permission. Location and context are entered by you; TapLead does not track your location.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontaktdaten nur mit Zustimmung erfassen. Standort und Kontext werden von Ihnen eingegeben; TapLead erfasst Ihren Standort nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record contact details only with permission. Location and context are entered by you; TapLead does not track your location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra los datos de contacto solo con permiso. Tú introduces la ubicación y el contexto; TapLead no rastrea tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer les coordonnées uniquement avec autorisation. La localisation et le contexte sont saisis par vous ; TapLead ne suit pas votre position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i dati di contatto solo previo consenso. La posizione e il contesto vengono inseriti da te; TapLead non traccia la tua posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先情報は許可を得た場合のみ記録します。位置情報や状況（コンテキスト）はユーザー自身が入力するものであり、TapLeadが位置情報を追跡することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처 정보는 반드시 동의를 얻은 후에만 기록하세요. 위치 및 상황 정보는 사용자가 직접 입력하며, TapLead는 사용자의 위치를 추적하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg contactgegevens alleen vast met toestemming. Locatie en context worden door jou ingevoerd; TapLead houdt je locatie niet bij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre dados de contato apenas com permissão. A localização e o contexto são inseridos por você; o TapLead não rastreia sua localização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在获得许可的情况下记录联系方式。位置和背景信息由您输入；TapLead 不会追踪您的位置。"
          }
        }
      }
    },
    "Record what matters, then review and edit before saving. Audio stays on your device and is not retained.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wichtige Punkte festhalten, dann vor dem Speichern überprüfen und bearbeiten. Die Audioaufnahme verbleibt auf Ihrem Gerät und wird nicht dauerhaft gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record what matters, then review and edit before saving. Audio stays on your device and is not retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra lo importante, luego revisa y edita antes de guardar. El audio permanece en tu dispositivo y no se almacena externamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer l'essentiel, puis vérifier et modifier avant d'enregistrer. L'audio reste sur votre appareil et n'est pas conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra ciò che conta, quindi rivedi e modifica prima di salvare. L'audio rimane sul tuo dispositivo e non viene conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要な内容を録音し、文字起こしを確認・編集してから保存してください。音声はデバイス上で処理され、保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요한 내용을 녹음한 후, 변환된 텍스트를 검토하고 수정한 다음 저장하세요. 음성 데이터는 기기에서만 처리되며 보관되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg vast wat belangrijk is en bekijk en bewerk dit voordat je het opslaat. De audio blijft op je apparaat staan en wordt niet bewaard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre o que importa e, em seguida, revise e edite antes de salvar. O áudio permanece no seu dispositivo e não é armazenado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录重要内容，保存前进行查看和编辑。音频保留在您的设备上，不会被上传留存。"
          }
        }
      }
    },
