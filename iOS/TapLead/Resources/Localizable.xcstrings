        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TapLead n'envoie pas de messages. Choisissez une destination dans le menu de partage et confirmez l'envoi à cet endroit."
          }
        },
        "it": {
          "stringUnit": {
