    "Enable anonymous activity measurement on your published card. Events will appear as people interact.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Aktivitätsmessung für Ihre veröffentlichte Karte aktivieren. Ereignisse werden angezeigt, sobald Interaktionen stattfinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable anonymous activity measurement on your published card. Events will appear as people interact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la medición anónima de actividad en tu tarjeta publicada. Los eventos aparecerán a medida que la gente interactúe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer la mesure anonyme de l'activité sur votre carte publiée. Les événements apparaîtront au fur et à mesure des interactions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita la misurazione anonima dell'attività sulla tua scheda pubblicata. Gli eventi appariranno man mano che le persone interagiranno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開したカードでの匿名アクティビティ計測を有効にします。相手が操作を行うとイベントが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시된 카드에서 익명 활동 측정 기능을 활성화하세요. 사람들이 상호작용할 때 이벤트가 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel anonieme activiteitsmeting in voor je gepubliceerde kaart. Gebeurtenissen verschijnen naarmate mensen interactie hebben."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a medição anônima de atividade no seu cartão publicado. Os eventos aparecerão conforme as pessoas interagirem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启已发布名片的匿名活动统计功能。当有人进行互动时，相关事件将会显示。"
          }
        }
      }
    },
