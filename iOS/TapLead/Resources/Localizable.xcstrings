    "Native notes can be captured offline. Public profiles, publication, AI and cloud sync require internet.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen können offline erfasst werden. Öffentliche Profile, Veröffentlichungen, KI und Cloud-Synchronisierung erfordern eine Internetverbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native notes can be captured offline. Public profiles, publication, AI and cloud sync require internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas nativas pueden capturarse sin conexión. Los perfiles públicos, la publicación, la IA y la sincronización en la nube requieren internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes natives peuvent être saisies hors ligne. Les profils publics, la publication, l'IA et la synchronisation cloud nécessitent une connexion Internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note native possono essere acquisite offline. I profili pubblici, la pubblicazione, l'IA e la sincronizzazione cloud richiedono Internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ機能はオフラインでも利用可能です。公開プロフィール、公開機能、AI、クラウド同期にはインターネット接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 메모는 오프라인에서도 작성할 수 있습니다. 공개 프로필, 게시, AI 및 클라우드 동기화에는 인터넷 연결이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities kunnen offline worden vastgelegd. Voor openbare profielen, publicatie, AI en cloudsynchronisatie is internet vereist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas nativas podem ser registradas offline. Perfis públicos, publicação, IA e sincronização na nuvem exigem internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生笔记可在离线状态下记录。公开资料、发布内容、AI 功能及云端同步需要网络连接。"
          }
        }
      }
    },
