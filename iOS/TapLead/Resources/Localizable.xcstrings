    "NFC writing is unavailable on this device. Use your QR code instead.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC-Schreiben ist auf diesem Gerät nicht verfügbar. Verwende stattdessen deinen QR-Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC writing is unavailable on this device. Use your QR code instead."
          }
        },
        "es": {
          "stringUnit": {
