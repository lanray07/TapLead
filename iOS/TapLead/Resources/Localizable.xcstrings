    "More than one connection matches. Choose the right person and review the date. No action has been taken.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt mehr als einen passenden Kontakt. Wähle die richtige Person aus und überprüfe das Datum. Es wurde keine Aktion ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one connection matches. Choose the right person and review the date. No action has been taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay más de una conexión coincidente. Elige a la persona correcta y revisa la fecha. No se ha realizado ninguna acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs contacts correspondent. Choisissez la bonne personne et vérifiez la date. Aucune action n'a été effectuée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più di un contatto corrisponde. Scegli la persona giusta e controlla la data. Nessuna azione è stata eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の接続が一致しました。適切な相手を選び、日付を確認してください。アクションは実行されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 연결이 여러 개 있습니다. 올바른 사람을 선택하고 날짜를 확인하세요. 아무런 조치도 취해지지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn meerdere overeenkomende connecties. Kies de juiste persoon en controleer de datum. Er is geen actie ondernomen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de uma conexão corresponde. Escolha a pessoa certa e verifique a data. Nenhuma ação foi realizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配到多个联系人。请选择正确的人选并确认日期。未执行任何操作。"
          }
        }
      }
