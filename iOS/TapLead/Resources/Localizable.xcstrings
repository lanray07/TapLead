    "TapLead does not send messages. Choose a destination in the Share Sheet and confirm there.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TapLead versendet keine Nachrichten. Wähle ein Ziel im Teilen-Menü und bestätige dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TapLead does not send messages. Choose a destination in the Share Sheet and confirm there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TapLead no envía mensajes. Elige un destino en el menú de compartir y confirma allí."
