    "Free includes one digital card, QR sharing, public profile and up to 50 synced leads.": {
      "comment": "Public UI copy. Non-English translations are machine-assisted with agent corrections; human language review is pending. See docs/LOCALISATION.md.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version umfasst eine digitale Visitenkarte, QR-Sharing, ein öffentliches Profil und bis zu 50 synchronisierte Leads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free includes one digital card, QR sharing, public profile and up to 50 synced leads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita incluye una tarjeta digital, uso compartido mediante código QR, perfil público y hasta 50 contactos sincronizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'offre gratuite inclut une carte numérique, le partage par QR code, un profil public et jusqu'à 50 prospects synchronisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano gratuito include un biglietto digitale, condivisione tramite QR, profilo pubblico e fino a 50 lead sincronizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランには、デジタルカード1枚、QRコードでの共有、公開プロフィール、および最大50件の同期済みリード（見込み客）が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 플랜에는 디지털 명함 1개, QR 공유, 공개 프로필, 최대 50개의 동기화된 리드(잠재 고객) 정보가 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis versie omvat één digitale kaart, delen via QR, een openbaar profiel en tot 50 gesynchroniseerde leads."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito inclui um cartão digital, compartilhamento via QR, perfil público e até 50 leads sincronizados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版包含一张电子名片、二维码分享、公开个人资料以及最多 50 条同步的潜在客户信息。"
          }
        }
      }
