PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=data/taplead.sqlite
# In production use HTTPS, a private listening interface, and a trusted reverse proxy.
NODE_ENV=development
APPLE_CLIENT_ID=com.taplead.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# 64 hexadecimal characters (32 random bytes), stored only in your secret manager.
TOKEN_ENCRYPTION_KEY=
APPLE_BUNDLE_ID=com.taplead.app
APPLE_APP_ID=
# Semicolon-separated paths to Apple Root CA DER files from Apple's PKI site.
APPLE_ROOT_CERT_PATHS=
# Enable only after signed-transaction, refund and renewal sandbox tests pass.
SUBSCRIPTIONS_ENABLED=false
# Optional authenticated gateway implementing the contract in docs/AI.md
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
# Public policy pages; update alongside the actual production service practices.
PRIVACY_URL=https://github.com/lanray07/TapLead/blob/main/docs/PRIVACY.md
TERMS_URL=https://github.com/lanray07/TapLead/blob/main/docs/TERMS.md
